# ─── Stock Portfolio Engine – Backend ───
# Copy this file to .env and fill in your values.
# pydantic-settings loads .env automatically.

# Comma-separated list of allowed frontend origins (JSON array format)
CORS_ORIGINS=["http://localhost:3000"]

# Minimum investment amount ($)
MIN_INVESTMENT=5000

# Max strategies a user can combine
MAX_STRATEGIES=2

# Number of history snapshots to retain
HISTORY_MAX_ENTRIES=5

# In-memory cache TTL (seconds)
CACHE_TTL_SECONDS=60

# Path to SQLite database file (relative to backend/ or absolute)
# On Render with persistent disk, use an absolute path like:
# DATABASE_PATH=/var/data/portfolio.db
DATABASE_PATH=portfolio.db
